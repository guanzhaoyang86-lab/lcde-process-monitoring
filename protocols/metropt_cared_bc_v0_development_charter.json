  "development_method_contract": {
    "encoder": {
      "type": "causal temporal convolutional network",
      "residual_blocks": 4,
      "channels": 64,
      "kernel_size": 3,
      "dilations": [1, 2, 4, 8],
      "latent_width": 32,
      "dropout": 0.1,
      "seeds": [17, 29, 43],
      "ensemble_rule": "elementwise median forecast",
      "optimizer": "AdamW",
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "maximum_epochs": 50,
      "early_stopping_patience": 8,
      "primary_loss": "multi-horizon Huber forecast loss with deterministic control-state-balanced sampling",
      "auxiliary_loss": null,
      "auxiliary_loss_weight": 0.0,
      "required_training_device": "cuda"
    },
    "residual_representation": {
      "forecast_error_horizons_minutes": [1, 3, 5],
      "forecast_error_channel_count": 21,
      "physics_features": [
        "TP2_minus_TP3",
        "TP3_minus_Reservoirs",
        "TP3_one_minute_slope",
        "Reservoirs_one_minute_slope",
        "pressure_rise_per_motor_current",
        "ten_minute_loaded_duty_fraction",
        "DV_pressure_discharge_pulse_amplitude",
        "DV_pressure_discharge_pulse_duration",
        "Caudal_impulses_per_loaded_minute",
        "Oil_temperature_five_minute_slope"
      ],
      "future_values_used_in_a_score_at_its_timestamp": false,
      "state_covariance": "fit-only Ledoit-Wolf shrinkage covariance",
      "rare_state_minimum_fit_minutes": 500,
      "rare_state_action": "pool to the nearest frequent control state by Hamming distance with deterministic lexical tie break"
    },
    "fault_direction": {
      "source": "F1 only versus dev_healthy matched by control state",
      "location_estimator": "Huber mean",
      "state_shrinkage": "rho_s=n_s/(n_s+500) toward the global F1 direction",
      "windows_are_not_independent_failure_replicates": true
    },
    "channels": {
      "energy": "E_t = r_t' (Sigma_s + lambda I)^(-1) r_t",
      "directional": "D_t = max(0, v_s' Sigma_s^(-1) r_t / sqrt(v_s' Sigma_s^(-1) v_s))",
      "normalization": "separate dev_healthy empirical-rank Gaussian transforms clipped to [-4,8]"
    },
    "cusum": {
      "recursion": "G_t^j=max(0,G_(t-1)^j+Z_t^j-0.5), j in {energy,directional}",
      "page_kappa": 0.5,
      "reset": [
        "dataset-native midnight",
        "raw timestamp gap strictly greater than 60 seconds"
      ],
      "daily_run_loss": "maximum over all valid minutes and both channels",
      "alarm_comparison": "strictly greater than the frozen effective boundary"
    }
  },
